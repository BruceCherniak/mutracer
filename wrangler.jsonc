{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claypt-viewer",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "build": {
    "command": "npm run typecheck:viewer && npm run build:viewer"
  },
  "assets": {
    "directory": "./dist-viewer",
    "not_found_handling": "none"
  }
}
