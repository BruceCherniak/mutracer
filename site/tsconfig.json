{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "vite/client",
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "mutracer": [
        "src/main.ts"
      ],
      "mutracer/oidn": [
        "src/oidn.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
